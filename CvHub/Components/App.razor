@inject IConfiguration Config
@inject IHttpContextAccessor Ctx

@{
    var theme = Ctx.HttpContext?.Request.Cookies["cv_theme"] ?? "light";
    var lang = Ctx.HttpContext?.Request.Cookies["cv_lang"] ?? "en";
}
<!DOCTYPE html>
<html lang="@lang" class="@(theme == "dark" ? "dark " : "")lang-@lang" data-cloud-name="@Config["Cloudinary:CloudName"]" data-upload-preset="@Config["Cloudinary:UploadPreset"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CvHub.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* InteractiveAuto matches the Auto components used inside pages; page bodies declare their own mode. *@
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    @* Static root: routing happens during SSR; interactive pages opt in via @rendermode. Since every page here
       hits the database server-side (EF Core), pages are pinned to InteractiveServer; the Auto components inside
       them (Client project) resolve to the server runtime and upgrade to WASM on subsequent visits. *@
    <CvHub.Components.Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/marked.min.js"]"></script>
    <script src="@Assets["lib/purify.min.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/upload.js"]"></script>
</body>

</html>
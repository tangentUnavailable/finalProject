@inject IConfiguration Config
@inject IHttpContextAccessor Ctx

@{
    var theme = Ctx.HttpContext?.Request.Cookies["cv_theme"] ?? "light";
    var lang = Ctx.HttpContext?.Request.Cookies["cv_lang"] ?? "en";
}
<!DOCTYPE html>
<html lang="@lang" class="@(theme == "dark" ? "dark " : "")lang-@lang" data-cloud-name="@Config["Cloudinary:CloudName"]" data-upload-preset="@Config["Cloudinary:UploadPreset"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CvHub.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/marked.min.js"]"></script>
    <script src="@Assets["lib/purify.min.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/upload.js"]"></script>
</body>
</html>

@code {
    private IComponentRenderMode? PageRenderMode =>
        Ctx.HttpContext?.AcceptsInteractiveRouting() == true ? InteractiveServer : null;
}

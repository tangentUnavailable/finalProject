@using CvHub.Shared

<div class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-4">
    <div class="flex items-start justify-between gap-3">
        <div>
            <div class="font-semibold">@Project.Name</div>
            <div class="text-xs text-slate-400">
                @if (Project.Start is not null || Project.End is not null)
                {
                    <span>@(Project.Start is null && Project.End is null ? "" : $"{(Project.Start?.ToString("MMM yyyy") ?? "?")} — {(Project.End?.ToString("MMM yyyy") ?? "present")}")</span>
                }
            </div>
        </div>
        <div class="flex gap-1 opacity-0 transition-opacity duration-150 group-hover:opacity-100 focus-within:opacity-100">
            <button type="button" @onclick="OnEdit" title="Edit" class="rounded-lg p-1.5 hover:bg-slate-100 dark:hover:bg-slate-700" aria-label="Edit project">✏️</button>
            <button type="button" @onclick="OnDeleted" title="Delete" class="rounded-lg p-1.5 hover:bg-rose-50 dark:hover:bg-rose-900/30" aria-label="Delete project">🗑️</button>
        </div>
    </div>
    <div class="mt-1 flex flex-wrap gap-1">
        @foreach (var t in Project.Tags)
        {
            <span class="rounded-full bg-brand-50 dark:bg-brand-900/40 px-2 py-0.5 text-xs text-brand-700 dark:text-brand-300">@t</span>
        }
    </div>
    <MarkdownDisplay Markdown="@Project.Description" Class="mt-2" />
</div>

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }
}

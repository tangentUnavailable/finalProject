@using Microsoft.AspNetCore.Identity
@using CvHub.Data

@inject SignInManager<ApplicationUser> SignInManager

<nav class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <ul class="flex flex-col gap-0.5">
        <li>
            <NavLink href="Account/Manage/Email"
                     class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 no-underline transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white"
                     activeClass="bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Email</NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/ChangePassword"
                     class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 no-underline transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white"
                     activeClass="bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Password</NavLink>
        </li>
        @if (hasExternalLogins)
        {
            <li>
                <NavLink href="Account/Manage/ExternalLogins"
                         class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 no-underline transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white"
                         activeClass="bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">External logins</NavLink>
            </li>
        }
        <li>
            <NavLink href="Account/Manage/TwoFactorAuthentication"
                     class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 no-underline transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white"
                     activeClass="bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Two-factor authentication</NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/Passkeys"
                     class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 no-underline transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white"
                     activeClass="bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Passkeys</NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/PersonalData"
                     class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 no-underline transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white"
                     activeClass="bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">Personal data</NavLink>
        </li>
    </ul>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}

@inherits LayoutComponentBase
@layout CvHub.Components.Layout.MainLayout

<section class="manage-page mx-auto w-full max-w-4xl py-2">
    <h1 class="mb-1 text-2xl font-bold tracking-tight">Manage your account</h1>
    <p class="mb-6 text-sm text-slate-500 dark:text-slate-400">Change your account settings</p>

    <div class="flex flex-col gap-6 lg:flex-row">
        <aside class="w-full shrink-0 lg:w-56">
            <ManageNavMenu />
        </aside>
        <div class="min-w-0 flex-1">
            @Body
        </div>
    </div>
</section>

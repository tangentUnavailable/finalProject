@page "/Account/Manage"

@using Microsoft.AspNetCore.Identity
@using CvHub.Data
@using CvHub.Shared

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@I18n.T("account.manage.title") — CvHub</PageTitle>

@if (_loading)
{
    <div class="text-slate-400">@I18n.T("common.loading")</div>
}
else if (_user is not null)
{
    <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0">
                <div class="text-xs uppercase tracking-wide text-slate-400">@I18n.T("account.email.label")</div>
                <div class="flex min-w-0 flex-wrap items-center gap-2">
                    <span class="truncate text-sm font-medium">@_email</span>
                    @if (_confirmed)
                    {
                        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> @I18n.T("profile.email.confirmed")
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">
                            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> @I18n.T("profile.email.unconfirmed")
                        </span>
                    }
                </div>
            </div>
            <a href="/Account/Manage/Email" class="shrink-0 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-700">
                @I18n.T("account.email.change")
            </a>
        </div>
    </div>

    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">@I18n.T("account.manage.hint")</p>
}

@code {
    private ApplicationUser? _user;
    private string _email = "";
    private bool _confirmed;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserManager.GetUserAsync((await AuthState.GetAuthenticationStateAsync()).User);
        if (_user is not null)
        {
            _email = await UserManager.GetEmailAsync(_user) ?? _user.UserName ?? "";
            _confirmed = await UserManager.IsEmailConfirmedAsync(_user);
        }
        _loading = false;
    }
}
@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-slate-200 dark:border-slate-700 bg-white/90 dark:bg-slate-900/90 backdrop-blur">
        <div class="mx-auto max-w-7xl px-3 sm:px-6">
            <div class="flex h-14 items-center gap-3">
                <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-2 font-bold text-lg text-brand-600 dark:text-brand-400 shrink-0">
                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 text-white text-sm">CV</span>
                    <span class="hidden sm:inline">CvHub</span>
                </NavLink>

                <form action="search" method="get" class="flex-1 max-w-xl">
                    <label class="relative block">
                        <span class="sr-only">Search</span>
                        <input type="search" name="q" value="@_q" placeholder="@I18n.T("search.placeholder")"
                               class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
                    </label>
                </form>

                <div class="ml-auto flex items-center gap-1">
                    @* Two variants per toggle; CSS shows the right one for the current mode (baked into <html> classes). *@
                    <a href="/prefs/theme/dark" title="@I18n.T("theme.toggle")" aria-label="@I18n.T("theme.toggle")"
                       class="theme-light-only rounded-lg p-2 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg>
                    </a>
                    <a href="/prefs/theme/light" title="@I18n.T("theme.toggle")" aria-label="@I18n.T("theme.toggle")"
                       class="theme-dark-only rounded-lg p-2 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>
                    </a>
                    <a href="/prefs/lang/es" class="lang-en-only rounded-lg px-2 py-1.5 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800">@I18n.T("lang.toggle")</a>
                    <a href="/prefs/lang/en" class="lang-es-only rounded-lg px-2 py-1.5 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800">@I18n.T("lang.toggle")</a>
                    <AuthorizeView>
                        <Authorized>
                            <a href="/profile" class="rounded-lg px-2 py-1.5 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800 max-w-40 truncate">
                                @(I18n.T("nav.hello")), @context.User.FindFirst("display_name")?.Value
                            </a>
                            <form action="Account/Logout" method="post" class="inline">
                                <AntiforgeryToken />
                                @* The Logout endpoint binds [FromForm] string returnUrl; without this hidden
                                   field every logout POST failed model binding with an empty 400. *@
                                <input type="hidden" name="returnUrl" value="@LogoutReturnUrl" />
                                <button type="submit" class="rounded-lg px-2 py-1.5 text-sm hover:bg-slate-100 dark:hover:bg-slate-800">@I18n.T("nav.logout")</button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <a href="Account/Login" class="rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-700">@I18n.T("nav.login")</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
            <NavMenu />
        </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-3 py-6 sm:px-6">
        @Body
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-700 py-4 text-center text-xs text-slate-500">
        CvHub — CV Management System
    </footer>
</div>

@code {
    private string? _q;

    // Path-only relative value (~/ prefix is added by the endpoint); excludes query string.
    private string LogoutReturnUrl => HttpContext?.Request.Path.HasValue == true ? HttpContext.Request.Path.Value! : "";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        _q = HttpContext?.Request.Query["q"];
    }

    private string CurrentTheme => HttpContext?.Request.Cookies["cv_theme"] ?? "light"; // SSR-only; circuits see "light"
}

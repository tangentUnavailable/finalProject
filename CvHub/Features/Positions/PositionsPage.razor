@rendermode InteractiveServer
@page "/positions"
@using CvHub.Shared
@using CvHub.Features.Positions
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Positions — CvHub</PageTitle>

<div class="mb-4 flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-bold">@I18n.T("nav.positions")</h1>
    <AuthorizeView Roles="Admin,Recruiter">
        <button type="button" @onclick='() => OpenEditor(null)' class="ml-auto rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-700">
            + @I18n.T("pos.create")
        </button>
    </AuthorizeView>
</div>

<AuthorizeView Roles="Admin,Recruiter">
    <div class="@ToolbarClass">
        <span class="text-sm font-medium">@_selected.Count @I18n.T("common.selected")</span>
        <button type="button" @onclick="DeleteSelected" class="rounded-lg bg-rose-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-rose-700">
            @I18n.T("common.delete")
        </button>
    </div>
</AuthorizeView>

<div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-slate-200 dark:border-slate-700 text-left text-xs uppercase tracking-wide text-slate-500">
                @if (_canEdit)
                {
                    <th class="w-10 px-3 py-2"><input type="checkbox" checked="@AllChecked" @onchange="ToggleAll" class="h-4 w-4 rounded accent-brand-600" /></th>
                }
                <th class="cursor-pointer px-4 py-2" @onclick='() => SortBy("title")'>@I18n.T("table.title") @SortMark("title")</th>
                <th class="cursor-pointer px-4 py-2" @onclick='() => SortBy("company")'>@I18n.T("table.company") @SortMark("company")</th>
                <th class="cursor-pointer px-4 py-2" @onclick='() => SortBy("level")'>@I18n.T("table.level") @SortMark("level")</th>
                <th class="cursor-pointer px-4 py-2" @onclick='() => SortBy("cvs")'>@I18n.T("table.cvs") @SortMark("cvs")</th>
                <th class="cursor-pointer px-4 py-2" @onclick='() => SortBy("updated")'>@I18n.T("table.updated") @SortMark("updated")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _rows)
            {
                var row = p;
                <tr class="group border-b border-slate-100 dark:border-slate-700/50 last:border-0 hover:bg-slate-50 dark:hover:bg-slate-700/30">
                    @if (_canEdit)
                    {
                        <td class="px-3 py-2">
                            <input type="checkbox" checked="@(_selected.Contains(row.Id))" @onchange="e => ToggleRow(row.Id, e)" class="h-4 w-4 rounded accent-brand-600" />
                        </td>
                    }
                    <td class="px-4 py-2">
                        <a href="positions/@row.Id" class="font-medium text-brand-600 dark:text-brand-400 hover:underline">@row.Title</a>
                        @* Appearing context actions on row hover (no per-row button columns) *@
                        @if (_canEdit)
                        {
                            <span class="ml-2 hidden gap-1 group-hover:inline-flex">
                                <button type="button" @onclick='() => OpenEditor(row.Id)' title="@I18n.T("pos.edit")" class="text-xs text-slate-400 hover:text-brand-600">✏️</button>
                                <button type="button" @onclick='() => Duplicate(row.Id)' title="@I18n.T("pos.duplicate")" class="text-xs text-slate-400 hover:text-brand-600">⧉</button>
                                <button type="button" @onclick='() => DeleteOne(row.Id)' title="@I18n.T("pos.delete")" class="text-xs text-slate-400 hover:text-rose-600">🗑️</button>
                            </span>
                        }
                    </td>
                    <td class="px-4 py-2 text-slate-600 dark:text-slate-300">@row.Company</td>
                    <td class="px-4 py-2 text-slate-600 dark:text-slate-300">@row.Level</td>
                    <td class="px-4 py-2 text-slate-600 dark:text-slate-300">@row.CvCount</td>
                    <td class="px-4 py-2 text-slate-500">@row.UpdatedAt.ToString("MMM d, HH:mm")</td>
                </tr>
            }
            @if (!_rows.Any())
            {
                <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">No positions found.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (_editorOpen)
{
    <PositionEditor PositionId="_editId" OnClosed="OnEditorClosed" />
}

@code {
    private List<Row> _rows = [];
    private HashSet<int> _selected = [];
    private bool _editorOpen;
    private int? _editId;
    private bool _canEdit;
    private string _sortKey = "updated";
    private bool _desc = true;

    private string ToolbarClass => _selected.Count > 0
        ? "mb-3 flex items-center gap-3 rounded-xl border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-900/20 px-4 py-2"
        : "hidden";

    private bool AllChecked => _rows.Count > 0 && _rows.All(r => _selected.Contains(r.Id));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _canEdit = auth.User.IsInRole("Admin") || auth.User.IsInRole("Recruiter");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _rows = await db.Positions
            .Select(p => new Row
            {
                Id = p.Id, Title = p.Title, Company = p.Company, Level = p.Level, Access = p.Access,
                UpdatedAt = p.UpdatedAt,
                CvCount = p.Cvs.Count(c => c.Status == CvStatus.Published),
            })
            .ToListAsync();

        _rows = (_sortKey, _desc) switch
        {
            ("title", false) => _rows.OrderBy(r => r.Title, StringComparer.OrdinalIgnoreCase).ToList(),
            ("title", true) => _rows.OrderByDescending(r => r.Title, StringComparer.OrdinalIgnoreCase).ToList(),
            ("company", false) => _rows.OrderBy(r => r.Company ?? "").ToList(),
            ("company", true) => _rows.OrderByDescending(r => r.Company ?? "").ToList(),
            ("level", false) => _rows.OrderBy(r => r.Level ?? "").ToList(),
            ("level", true) => _rows.OrderByDescending(r => r.Level ?? "").ToList(),
            ("cvs", false) => _rows.OrderBy(r => r.CvCount).ToList(),
            ("cvs", true) => _rows.OrderByDescending(r => r.CvCount).ToList(),
            ("updated", false) => _rows.OrderBy(r => r.UpdatedAt).ToList(),
            _ => _rows.OrderByDescending(r => r.UpdatedAt).ToList(),
        };
    }

    private void SortBy(string key) { if (_sortKey == key) _desc = !_desc; else { _sortKey = key; _desc = false; } _ = LoadAsync(); }

    private string SortMark(string key) => _sortKey == key ? (_desc ? "↓" : "↑") : "";

    private void ToggleAll(ChangeEventArgs e)
    {
        _selected = e.Value is true ? new HashSet<int>(_rows.Select(r => r.Id)) : [];
    }

    private void ToggleRow(int id, ChangeEventArgs e)
    {
        if (e.Value is true) _selected.Add(id); else _selected.Remove(id);
    }

    private async Task DeleteSelected()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Positions.Where(p => _selected.Contains(p.Id))
            .ExecuteUpdateAsync(s => s.SetProperty(p => p.IsDeleted, true).SetProperty(p => p.UpdatedAt, DateTimeOffset.UtcNow));
        _selected.Clear();
        await LoadAsync();
    }

    private async Task DeleteOne(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Positions.Where(p => p.Id == id)
            .ExecuteUpdateAsync(s => s.SetProperty(p => p.IsDeleted, true).SetProperty(p => p.UpdatedAt, DateTimeOffset.UtcNow));
        await LoadAsync();
    }

    private async Task Duplicate(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var auth = await AuthState.GetAuthenticationStateAsync();
        var uid = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        await PositionCommands.DuplicateAsync(db, id, uid);
        await LoadAsync();
    }

    private void OpenEditor(int? id) { _editId = id; _editorOpen = true; }

    private async Task OnEditorClosed()
    {
        _editorOpen = false;
        await LoadAsync();
    }

    public sealed class Row
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string? Company { get; set; }
        public string? Level { get; set; }
        public PositionAccess Access { get; set; }
        public DateTimeOffset UpdatedAt { get; set; }
        public int CvCount { get; set; }
    }
}
